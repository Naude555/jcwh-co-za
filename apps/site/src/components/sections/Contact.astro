---
import Section from "../Section.astro";
import SectionHeading from "../SectionHeading.astro";
import Icon, { type IconName } from "../Icon.astro";
import { contactDetails } from "../../data/site";
import { slugify } from "../../utils/url";
import type { SectionOf } from "./types";

/**
 * Contact block: recovered contact details plus a form.
 *
 * A static build has no server, so `form.action` must point at wherever the
 * form is handled (Formspree/Netlify/Cloudflare Worker, or an Astro action once
 * an adapter is added). When it is left empty we render the details and a
 * mailto fallback instead of a form that would silently do nothing.
 */
type Props = SectionOf<"contact">;

const { eyebrow, heading, subheading, body, details = [], form } = Astro.props;

const rows = details.length
  ? details
  : contactDetails().map((detail) => ({
      icon: detail.icon,
      label: detail.label,
      value: detail.value,
      href: detail.href,
    }));

const hasForm = Boolean(form && form.action);
const fallbackEmail = contactDetails().find((detail) => detail.icon === "mail")?.value;
---

<Section id={heading ? slugify(heading) : "contact"}>
  <SectionHeading eyebrow={eyebrow} heading={heading} subheading={subheading} />

  <div class="mt-10 grid gap-12 lg:grid-cols-2">
    <div>
      {body && <p class="mb-8 max-w-prose opacity-75">{body}</p>}

      <dl class="space-y-5">
        {
          rows.map((row) => (
            <div class="flex items-start gap-3">
              <span class="grid size-10 shrink-0 place-items-center rounded-xl bg-primary/10 text-primary">
                <Icon name={(row.icon ?? "check") as IconName} size={18} />
              </span>
              <div>
                <dt class="text-xs font-semibold tracking-wide uppercase opacity-60">
                  {row.label}
                </dt>
                <dd class="mt-0.5">
                  {row.href ? (
                    <a href={row.href} class="link-underline">
                      {row.value}
                    </a>
                  ) : (
                    row.value
                  )}
                </dd>
              </div>
            </div>
          ))
        }
      </dl>
    </div>

    <div>
      {
        hasForm && form ? (
          <form
            action={form.action}
            method={form.method}
            class="card card-border border-base-300 bg-base-100"
          >
            <div class="card-body grid gap-4 sm:grid-cols-2">
              {form.fields.map((field) => (
                <label
                  class:list={["flex flex-col gap-1.5", field.half ? "sm:col-span-1" : "sm:col-span-2"]}
                >
                  <span class="text-sm font-medium">
                    {field.label}
                    {field.required && <span class="text-error"> *</span>}
                  </span>

                  {field.type === "textarea" ? (
                    <textarea
                      name={field.name}
                      class="textarea w-full"
                      rows={5}
                      required={field.required}
                      placeholder={field.placeholder}
                    />
                  ) : field.type === "select" ? (
                    <select name={field.name} class="select w-full" required={field.required}>
                      <option value="">Please choose…</option>
                      {field.options.map((option) => (
                        <option value={option}>{option}</option>
                      ))}
                    </select>
                  ) : (
                    <input
                      type={field.type}
                      name={field.name}
                      class="input w-full"
                      required={field.required}
                      placeholder={field.placeholder}
                      autocomplete={
                        field.type === "email"
                          ? "email"
                          : field.type === "tel"
                            ? "tel"
                            : field.name === "name"
                              ? "name"
                              : "on"
                      }
                    />
                  )}
                </label>
              ))}

              {/* Honeypot: bots fill this, humans never see it. */}
              <input
                type="text"
                name="_company"
                tabindex="-1"
                autocomplete="off"
                aria-hidden="true"
                class="hidden"
              />

              <div class="sm:col-span-2">
                <button type="submit" class="btn btn-primary w-full sm:w-auto">
                  {form.submitLabel}
                </button>
              </div>
            </div>
          </form>
        ) : fallbackEmail ? (
          <div class="card card-border border-base-300 bg-base-100">
            <div class="card-body">
              <h3 class="card-title">Prefer email?</h3>
              <p class="opacity-70">
                Send us a message and we will get back to you within one working day.
              </p>
              <div class="card-actions mt-2">
                <a href={`mailto:${fallbackEmail}`} class="btn btn-primary">
                  <Icon name="mail" size={18} /> {fallbackEmail}
                </a>
              </div>
            </div>
          </div>
        ) : null
      }
    </div>
  </div>
</Section>
