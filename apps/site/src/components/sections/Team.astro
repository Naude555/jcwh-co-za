---
import Section from "../Section.astro";
import SectionHeading from "../SectionHeading.astro";
import SmartImage from "../SmartImage.astro";
import Icon from "../Icon.astro";
import { slugify } from "../../utils/url";
import type { SectionOf } from "./types";

/** People grid. */
type Props = SectionOf<"team">;

const { eyebrow, heading, subheading, columns = 3, members = [] } = Astro.props;

const colClass =
  columns === 1
    ? "sm:grid-cols-1"
    : columns === 2
      ? "sm:grid-cols-2"
      : columns === 4
        ? "sm:grid-cols-2 lg:grid-cols-4"
        : "sm:grid-cols-2 lg:grid-cols-3";
---

<Section id={heading ? slugify(heading) : undefined}>
  <SectionHeading eyebrow={eyebrow} heading={heading} subheading={subheading} align="center" />

  <ul class:list={["mt-12 grid gap-8", colClass]}>
    {
      members.map((member) => (
        <li class="text-center reveal-on-scroll">
          {member.photo ? (
            <SmartImage
              src={member.photo.src}
              alt={member.photo.alt || member.name}
              class="mx-auto size-32 rounded-full object-cover shadow-card"
              sizes="8rem"
            />
          ) : (
            <span
              class="mx-auto grid size-32 place-items-center rounded-full bg-primary/10 font-display text-3xl font-bold text-primary"
              aria-hidden="true"
            >
              {member.name.slice(0, 1)}
            </span>
          )}

          <h3 class="mt-4 text-lg font-semibold">{member.name}</h3>
          {member.role && <p class="text-sm text-primary">{member.role}</p>}
          {member.bio && <p class="mt-2 text-sm opacity-70">{member.bio}</p>}

          <ul class="mt-3 flex justify-center gap-2 text-sm">
            {member.email && (
              <li>
                <a href={`mailto:${member.email}`} class="link-underline inline-flex items-center gap-1.5">
                  <Icon name="mail" size={15} /> Email
                </a>
              </li>
            )}
            {member.phone && (
              <li>
                <a
                  href={`tel:${member.phone.replace(/[^\d+]/g, "")}`}
                  class="link-underline inline-flex items-center gap-1.5"
                >
                  <Icon name="phone" size={15} /> Call
                </a>
              </li>
            )}
          </ul>
        </li>
      ))
    }
  </ul>
</Section>
