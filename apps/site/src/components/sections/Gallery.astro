---
import Section from "../Section.astro";
import SectionHeading from "../SectionHeading.astro";
import SmartImage from "../SmartImage.astro";
import Button from "../Button.astro";
import { slugify } from "../../utils/url";
import type { SectionOf } from "./types";

/** Responsive image grid. */
type Props = SectionOf<"gallery">;

const {
  eyebrow,
  heading,
  subheading,
  columns = 3,
  images = [],
  actions = [],
} = Astro.props;

const colClass =
  columns === 1
    ? "sm:grid-cols-1"
    : columns === 2
      ? "sm:grid-cols-2"
      : columns === 4
        ? "sm:grid-cols-2 lg:grid-cols-4"
        : "sm:grid-cols-2 lg:grid-cols-3";
---

<Section id={heading ? slugify(heading) : undefined}>
  <SectionHeading eyebrow={eyebrow} heading={heading} subheading={subheading} align="center" />

  <ul class:list={["mt-12 grid gap-4", colClass]}>
    {
      images.map((image, index) => (
        <li class="overflow-hidden rounded-box bg-base-200 reveal-on-scroll">
          <SmartImage
            src={image.src}
            alt={image.alt || `${heading ?? "Gallery image"} ${index + 1}`}
            class="aspect-4/3 w-full object-cover transition-transform duration-500 hover:scale-[1.03]"
            sizes="(min-width: 1024px) 24rem, (min-width: 640px) 45vw, 90vw"
          />
        </li>
      ))
    }
  </ul>

  {
    actions.length > 0 && (
      <div class="mt-10 flex flex-wrap justify-center gap-3">
        {actions.map((action, index) => (
          <Button
            href={action.href}
            style={action.style ?? (index === 0 ? "primary" : "outline")}
            icon={action.icon}
            external={action.icon === "external"}
          >
            {action.label}
          </Button>
        ))}
      </div>
    )
  }
</Section>
