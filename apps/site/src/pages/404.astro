---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/Section.astro";
import Icon from "../components/Icon.astro";
import { site } from "../data/site";
---

<BaseLayout title="Page not found" description="The page you were looking for does not exist." noindex>
  <Section size="lg">
    <div class="mx-auto max-w-xl text-center">
      <p class="font-display text-6xl font-bold text-primary">404</p>
      <h1 class="mt-4 font-display text-3xl font-semibold tracking-tight">
        We could not find that page
      </h1>
      <p class="mt-4 opacity-70">
        The page may have moved during the rebuild of {site.name}. Try the home page or get in
        touch and we will point you in the right direction.
      </p>

      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="/" class="btn btn-primary">
          <Icon name="arrow-left" size={18} /> Back to home
        </a>
        {site.contact.email && (
          <a href={`mailto:${site.contact.email}`} class="btn btn-ghost">Contact us</a>
        )}
      </div>
    </div>
  </Section>
</BaseLayout>
