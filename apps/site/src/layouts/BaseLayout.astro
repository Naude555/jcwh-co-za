---
import { Font } from "astro:assets";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site, absoluteUrl, lightOnly } from "../data/site";

/**
 * Base document shell: SEO metadata, structured data, the pre-paint theme
 * script (so a dark-mode visitor never sees a white flash), the sticky header
 * and the footer.
 *
 * TODO(design): this is the only file that knows about <html>, so rebranding
 * starts here.
 */
interface Props {
  title?: string;
  description?: string;
  image?: string;
  /** Path or absolute URL; defaults to the current path. */
  canonical?: string;
  noindex?: boolean;
  type?: "website" | "article";
  publishedTime?: Date;
  modifiedTime?: Date;
  /** Extra schema.org nodes to embed alongside the site defaults. */
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  bodyClass?: string;
}

const {
  title,
  description = site.description,
  image,
  canonical,
  noindex = false,
  type = "website",
  publishedTime,
  modifiedTime,
  structuredData,
  bodyClass = "",
} = Astro.props;

const pageTitle = title
  ? // Scraped titles often already carry the site name ("Acme Ltd | Catalogue");
    // repeating it would read "Acme Ltd | Catalogue | Acme Ltd".
    title.toLowerCase().includes(site.name.toLowerCase())
    ? title
    : `${title} | ${site.name}`
  : `${site.name} — ${site.tagline}`;
const canonicalUrl = canonical
  ? absoluteUrl(canonical)
  : new URL(Astro.url.pathname, site.url).href;
const ogImage = image
  ? absoluteUrl(image)
  : site.logo.src
    ? absoluteUrl(site.logo.src)
    : undefined;

const useRemoteFonts = import.meta.env.PUBLIC_REMOTE_FONTS !== "0";
/* A preview deployment (PUBLIC_PREVIEW=1) is kept out of search results, so a
   client demo on a subdomain cannot compete with their live site. */
const preview = import.meta.env.PUBLIC_PREVIEW === "1";
const light = site.theme.light;
const dark = site.theme.dark;
const isLightOnly = lightOnly();

/* Applied before first paint, so there is no flash of the wrong theme. A
   light-only build drops any stored preference and pins the light palette. */
const themeInitScript = isLightOnly
  ? `(function(){try{localStorage.removeItem("theme");}catch(e){}document.documentElement.dataset.theme="${light}";})();`
  : `(function(){try{var k="theme";var s=localStorage.getItem(k);var d=window.matchMedia("(prefers-color-scheme: dark)").matches;document.documentElement.dataset.theme=s||(d?"${dark}":"${light}");}catch(e){}})();`;

const themeToggleScript = isLightOnly
  ? null
  : `(function(){var k="theme",r=document.documentElement,L="${light}",D="${dark}";var b=document.querySelectorAll("[data-theme-toggle]");function sync(){var dark=r.dataset.theme===D;b.forEach(function(t){t.setAttribute("aria-pressed",String(dark));t.setAttribute("aria-label",dark?"Switch to light theme":"Switch to dark theme");});}b.forEach(function(t){t.addEventListener("click",function(){var n=r.dataset.theme===D?L:D;r.dataset.theme=n;try{localStorage.setItem(k,n);}catch(e){}sync();});});sync();})();`;

/* Gallery lightbox: one delegated listener, so every [data-lightbox] link on the
   page works — including ones rendered later. Without JS the link still opens the
   full-size image, so nothing is lost. */
const lightboxScript = `(function(){var d=document.getElementById("lightbox");if(!d||typeof d.showModal!=="function")return;var i=d.querySelector("[data-lightbox-image]");document.addEventListener("click",function(e){var a=e.target.closest("[data-lightbox]");if(!a)return;var href=a.getAttribute("href");if(!href)return;e.preventDefault();i.src=href;i.alt=a.getAttribute("data-alt")||"";d.showModal();});if(i){i.addEventListener("click",function(){d.close();});}d.addEventListener("close",function(){i.removeAttribute("src");i.alt="";});})();`;

const defaultSchema = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: site.name,
    url: site.url,
    description: site.description,
    inLanguage: site.locale,
  },
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: site.legalName || site.name,
    url: site.url,
    ...(site.logo.src ? { logo: absoluteUrl(site.logo.src) } : {}),
    ...(site.contact.email ? { email: site.contact.email } : {}),
    ...(site.contact.phone ? { telephone: site.contact.phone } : {}),
    ...(site.socials.length ? { sameAs: site.socials.map((social) => social.href) } : {}),
  },
];

const schema = [...defaultSchema, ...(structuredData ? [structuredData].flat() : [])];
---

<!doctype html>
<html lang={site.locale} data-theme={light}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content={isLightOnly ? "light" : "light dark"} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {(noindex || preview) && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32x32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={site.locale} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {publishedTime && (
      <meta property="article:published_time" content={publishedTime.toISOString()} />
    )}
    {modifiedTime && (
      <meta property="article:modified_time" content={modifiedTime.toISOString()} />
    )}

    <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    {useRemoteFonts && <Font cssVariable="--font-heading" preload />}
    {useRemoteFonts && <Font cssVariable="--font-body" />}

    <script is:inline set:html={themeInitScript} />
    {
      schema.map((node) => (
        <script type="application/ld+json" set:html={JSON.stringify(node)} />
      ))
    }
  </head>

  <body class:list={[bodyClass]}>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-100 focus:rounded-lg focus:bg-primary focus:px-4 focus:py-2 focus:text-primary-content"
    >
      Skip to content
    </a>

    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    {
      /* Lightbox for gallery images. Native <dialog> needs no library, and the
         markup is inert on pages without images. */
    }
    <dialog
      id="lightbox"
      class="modal"
      aria-label="Image viewer"
      data-lightbox-dialog
    >
      <div class="modal-box max-w-6xl bg-transparent p-0 shadow-none">
        <img
          id="lightbox-image"
          src=""
          alt=""
          class="mx-auto max-h-[80vh] w-auto cursor-zoom-out rounded-box"
          data-lightbox-image
        />
      </div>
      <form method="dialog" class="modal-backdrop">
        <button aria-label="Close image viewer">close</button>
      </form>
    </dialog>

    {themeToggleScript && <script is:inline set:html={themeToggleScript} />}
    <script is:inline set:html={lightboxScript} />
  </body>
</html>
