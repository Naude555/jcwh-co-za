{
  "name": "scraper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Crawl a live website and generate an Astro + Tailwind CSS + daisyUI rebuild of it.",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "scrape": "node src/cli.ts scrape",
    "generate": "node src/cli.ts generate",
    "modernize": "node src/cli.ts modernize",
    "test": "node test/run.ts",
    "serve-fixture": "node test/fixture-server.ts",
    "typecheck": "tsc --noEmit",
    "browsers": "playwright install chromium"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "crawlee": "^3.18.1",
    "domhandler": "^5.0.3",
    "p-limit": "^7.3.3",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/turndown": "^5.0.6",
    "typescript": "^5.9.3"
  }
}
