# Copy to .env and adjust. All variables are optional — the defaults are safe.

# The public origin of the site being BUILT (not the site being scraped).
# Drives canonical URLs, the sitemap, the RSS feed and structured data.
# While reviewing a migration, leave this blank: the source URL recorded by the
# scraper is used instead.
# PUBLIC_SITE_URL=https://www.client-domain.com

# Set to 0 for offline/air-gapped builds. Brand fonts are then not downloaded
# from Google/Fontsource and the system font stack is used instead.
# PUBLIC_REMOTE_FONTS=0

# Umami analytics. Both of the first two are needed before the tag is written at
# all: leave them blank and no analytics script appears in the built HTML, so an
# unconfigured site sends nothing anywhere. They are exactly the two values in the
# Umami snippet — the script URL and the website's id from the dashboard — so
# switching a site on is a paste into its .env, not a code change. (On Coolify they
# are *build* variables: see the Dockerfile and docs/WORKFLOW.md.)
# PUBLIC_UMAMI_SRC=https://cloud.umami.is/script.js
# PUBLIC_UMAMI_WEBSITE_ID=00000000-0000-0000-0000-000000000000

# Optional: only these hostnames are counted. This is how a demo subdomain is kept
# out of the client's statistics without turning the tag off on it.
# PUBLIC_UMAMI_DOMAINS=acme.example,www.acme.example

# Optional, for a self-hosted Umami whose script is served from a different host
# than its API.
# PUBLIC_UMAMI_HOST_URL=https://analytics.example.com

# Optional: respect Do Not Track / Global Privacy Control.
# PUBLIC_UMAMI_DO_NOT_TRACK=1
